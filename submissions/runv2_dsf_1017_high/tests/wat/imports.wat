(module
  (type $t (func (param i32 i32) (result i32)))
  (import "env" "echo" (func $echo (param i32 i64 f32 f64 v128) (result i32 i64 f32 f64 v128)))
  (import "env" "sum" (func $sum (type $t)))
  (import "env" "vadd" (func $vadd (param v128 v128) (result v128)))
  (import "env" "ret_multi" (func $rm (result i32 i64)))
  (table 2 funcref)
  (elem (i32.const 0) $sum)
  (export "imported_sum" (func $sum))
  (func (export "call_echo") (param i32 i64 f32 f64 v128) (result i32 i64 f32 f64 v128)
    local.get 0 local.get 1 local.get 2 local.get 3 local.get 4
    call $echo)
  (func (export "call_sum") (param i32 i32) (result i32)
    local.get 0 local.get 1 call $sum)
  (func (export "call_vadd") (param v128 v128) (result v128)
    local.get 0 local.get 1 call $vadd)
  (func (export "call_rm") (result i32 i64) call $rm)
  (func (export "indirect_sum") (param i32 i32 i32) (result i32)
    local.get 0 local.get 1 local.get 2 call_indirect (type $t))
)
