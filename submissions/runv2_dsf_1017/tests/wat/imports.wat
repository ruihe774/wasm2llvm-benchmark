(module
  (import "env" "print_i32" (func $p (param i32)))
  (import "env" "print_i64" (func $p64 (param i64)))
  (import "env" "print_f32" (func $pf (param f32)))
  (import "env" "print_f64" (func $pd (param f64)))
  (import "env" "print_v128" (func $pv (param v128)))
  (import "env" "putchar" (func $pc (param i32)))
  (import "spectest" "print" (func $pr))
  (import "spectest" "print_i32" (func $pi (param i32)))
  (import "spectest" "print_i64" (func $pi64 (param i64)))
  (import "spectest" "print_f32" (func $pif32 (param f32)))
  (import "spectest" "print_f64" (func $pif64 (param f64)))
  (import "spectest" "print_i32_f32" (func $pif (param i32 f32)))
  (import "spectest" "print_f64_f64" (func $pdd (param f64 f64)))
  (memory (export "memory") 1)
  (table 4 funcref)
  (elem (i32.const 0) $p)
  (type $t0 (func (param i32)))

  (func (export "go") (param i32)
    (call $pr)
    (call $p (local.get 0))
    (call $p64 (i64.const -1234567890123))
    (call $pf (f32.const 0x1.8p+0))
    (call $pd (f64.const -0x1.2p+1))
    (call $pv (v128.const i32x4 0x01020304 0x05060708 0x090a0b0c 0x0d0e0f10))
    (call $pc (i32.const 65))
    (call $pi (local.get 0))
    (call $pi64 (i64.const 987654321))
    (call $pif32 (f32.const -0x1p-1))
    (call $pif64 (f64.const 0x1.8p+10))
    (call $pif (i32.const 11) (f32.const 0x1.4p+2))
    (call $pdd (f64.const 0x1p+0) (f64.const -0x1p+1)))

  (func (export "call_ind_import") (param i32 i32)
    (call_indirect (type $t0) (local.get 1) (local.get 0)))

  (func (export "twice") (param i32) (result i32)
    (call $p (i32.mul (local.get 0) (i32.const 2)))
    (i32.mul (local.get 0) (i32.const 2)))
)
